  font-size: 0.85rem;
  font-weight: 600;
  white-space: nowrap;
}


/* ===== Booking Form ===== */
.booking-form-wrapper {
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid rgba(255, 107, 26, 0.2);
}

.booking-form-wrapper .form-title {
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-input[type="date"],
.form-input[type="time"],
.form-input select,
select.form-input {
  width: 100%;
