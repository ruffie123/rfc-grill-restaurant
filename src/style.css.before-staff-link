/* RFC GRILL RESTAURANT - Pure Vanilla CSS */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  --bg-dark: #0A0A0F;
  --bg-surface: #12121A;
  --bg-card: rgba(22, 22, 32, 0.8);
  --bg-card-hover: rgba(28, 28, 42, 0.95);
  --border-glass: rgba(255, 255, 255, 0.08);
  --border-glow: rgba(255, 107, 26, 0.3);
  --orange-neon: #FF6B1A;
  --orange-hover: #FF853E;
  --orange-glow: rgba(255, 107, 26, 0.4);
  --gold: #FFD700;
  --gold-glow: rgba(255, 215, 0, 0.25);
  --text-light: #F8F9FA;
  --text-muted: #9E9EB2;
  --text-dim: #6B6B80;
  --font-display: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  color-scheme: dark;
}

body {
  background-color: var(--bg-dark);
  color: var(--text-light);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  background-image: 
    radial-gradient(circle at 15% 20%, rgba(255, 107, 26, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 85% 65%, rgba(255, 215, 0, 0.05) 0%, transparent 45%);
  background-attachment: fixed;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

button, input, textarea, a {
  font-family: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  cursor: pointer;
  border: none;
  background: none;
}

.tabular {
  font-variant-numeric: tabular-nums;
}

.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

@media (min-width: 768px) {
  .container {
    padding: 0 32px;
  }
}

/* ==========================================================================
   HEADER (Sticky, Glassmorphic)
   ========================================================================== */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  background: rgba(10, 10, 15, 0.85);
  border-bottom: 1px solid var(--border-glass);
  transition: var(--transition);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, rgba(255, 107, 26, 0.2), rgba(255, 215, 0, 0.15));
  border: 1px solid var(--border-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--orange-neon);
  box-shadow: 0 0 15px var(--orange-glow);
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #FFFFFF;
  line-height: 1.1;
}

.brand-subtitle {
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  color: var(--orange-neon);
  text-transform: uppercase;
  margin-top: 2px;
}

.nav-links {
  display: none;
  align-items: center;
  gap: 32px;
}

.nav-link {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: var(--transition);
  position: relative;
  padding: 6px 0;
}

.nav-link:hover, .nav-link.active {
  color: #FFFFFF;
}

.nav-link:hover::after, .nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--orange-neon);
  border-radius: 2px;
  box-shadow: 0 0 8px var(--orange-glow);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-header-order {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--orange-neon), #E0530A);
  color: #FFFFFF;
  font-weight: 600;
  font-size: 0.875rem;
  padding: 10px 18px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  box-shadow: 0 4px 14px var(--orange-glow);
  white-space: nowrap;
}

.btn-header-order:hover {
  background: linear-gradient(135deg, var(--orange-hover), var(--orange-neon));
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(255, 107, 26, 0.5);
}

.btn-hamburger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: var(--radius-sm);
  color: var(--text-light);
  border: 1px solid var(--border-glass);
  background: rgba(255, 255, 255, 0.03);
}

@media (min-width: 900px) {
  .nav-links {
    display: flex;
  }
  .btn-hamburger {
    display: none;
  }
}

/* Mobile Nav Drawer */
.mobile-nav {
  position: fixed;
  top: 74px;
  left: 0;
  width: 100%;
  background: rgba(10, 10, 15, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-glass);
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transform: translateY(-120%);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 99;
}

.mobile-nav.open {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
}

.mobile-nav-link {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-light);
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.mobile-nav-link:hover {
  color: var(--orange-neon);
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero-section {
  position: relative;
  min-height: calc(100vh - 74px);
  display: flex;
  align-items: center;
  padding: 60px 0 80px;
  overflow: hidden;
}

.hero-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(180deg, rgba(10, 10, 15, 0.75) 0%, rgba(10, 10, 15, 0.92) 100%),
              url('/src/assets/images/hero_charcoal_grill_1791207242142.jpg') center/cover no-repeat;
  filter: brightness(0.65) contrast(1.15);
}

.hero-glow {
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 26, 0.25) 0%, transparent 70%);
  top: 15%;
  right: -100px;
  z-index: 2;
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 5;
  max-width: 760px;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--orange-neon);
  margin-bottom: 18px;
  background: rgba(255, 107, 26, 0.1);
  border: 1px solid rgba(255, 107, 26, 0.3);
  padding: 6px 14px;
  border-radius: 40px;
}

.hero-headline {
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 6vw, 4.5rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.03em;
  color: #FFFFFF;
  margin-bottom: 22px;
  text-wrap: balance;
}

.hero-headline span {
  background: linear-gradient(135deg, #FFFFFF 30%, var(--orange-neon) 80%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subheadline {
  font-size: clamp(1rem, 1.8vw, 1.25rem);
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 36px;
  max-width: 640px;
  text-wrap: balance;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 48px;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--orange-neon), #DE5008);
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  box-shadow: 0 4px 20px var(--orange-glow);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--orange-hover), var(--orange-neon));
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(255, 107, 26, 0.5);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: var(--gold);
  color: var(--gold);
  transform: translateY(-2px);
}

.hero-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px 28px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.hero-badge-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #E2E2EA;
}

.badge-icon {
  color: var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==========================================================================
   SECTION COMMON STYLES
   ========================================================================== */
.section {
  padding: 90px 0;
  position: relative;
}

.section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 48px;
}

.section-tag {
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--orange-neon);
  margin-bottom: 10px;
  display: block;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #FFFFFF;
  line-height: 1.15;
}

.section-subtitle {
  margin-top: 12px;
  color: var(--text-muted);
  font-size: 1rem;
}

/* ==========================================================================
   MENU SECTION
   ========================================================================== */
.menu-controls {
  margin-bottom: 36px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.menu-search-wrapper {
  position: relative;
  max-width: 520px;
  margin: 0 auto;
  width: 100%;
}

.menu-search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-dim);
  pointer-events: none;
}

.menu-search-input {
  width: 100%;
  background: var(--bg-surface);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-sm);
  padding: 14px 44px 14px 48px;
  color: #FFFFFF;
  font-size: 0.9375rem;
  outline: none;
  transition: var(--transition);
}

.menu-search-input:focus {
  border-color: var(--orange-neon);
  box-shadow: 0 0 16px rgba(255, 107, 26, 0.25);
  background: rgba(22, 22, 32, 0.95);
}

.menu-search-clear {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-dim);
  padding: 4px;
  border-radius: 4px;
  display: none;
}

.menu-search-clear:hover {
  color: #FFFFFF;
}

/* Category Tabs Horizontal Scroll */
.category-tabs-container {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.category-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 8px 4px 14px;
  scrollbar-width: thin;
  scrollbar-color: var(--orange-neon) rgba(255, 255, 255, 0.05);
  -webkit-overflow-scrolling: touch;
}

.category-tabs::-webkit-scrollbar {
  height: 4px;
}

.category-tabs::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 2px;
}

.category-tabs::-webkit-scrollbar-thumb {
  background: var(--orange-neon);
  border-radius: 2px;
}

.category-tab {
  white-space: nowrap;
  padding: 8px 16px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  border-radius: 30px;
  color: var(--text-muted);
  font-size: 0.875rem;
  font-weight: 500;
  transition: var(--transition);
  flex-shrink: 0;
}

.category-tab:hover {
  color: #FFFFFF;
  border-color: rgba(255, 107, 26, 0.4);
  background: rgba(255, 107, 26, 0.06);
}

.category-tab.active {
  background: var(--orange-neon);
  color: #FFFFFF;
  border-color: var(--orange-neon);
  font-weight: 600;
  box-shadow: 0 4px 14px var(--orange-glow);
}

.menu-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  color: var(--text-muted);
  font-size: 0.875rem;
}

.menu-active-category-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: #FFFFFF;
}

/* Menu Grid */
.menu-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

@media (min-width: 640px) {
  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .menu-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
}

@media (min-width: 1280px) {
  .menu-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Menu Item Card (Glassmorphic) */
.menu-card {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: var(--transition);
  position: relative;
}

.menu-card:hover {
  background: var(--bg-card-hover);
  border-color: var(--border-glow);
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 107, 26, 0.15);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #14141E;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.menu-card:hover .card-img {
  transform: scale(1.06);
}

.card-category-tag {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(10, 10, 15, 0.8);
  backdrop-filter: blur(6px);
  color: var(--gold);
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid rgba(255, 215, 0, 0.2);
}

.card-body {
  padding: 18px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.card-title {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6px;
  line-height: 1.3;
}

.card-desc {
  font-size: 0.8125rem;
  color: var(--text-muted);
  margin-bottom: 12px;
  line-height: 1.4;
  flex-grow: 1;
}

/* Size Selector for items with multiple sizes */
.size-selector {
  display: flex;
  gap: 6px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}

.size-pill {
  padding: 3px 8px;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-muted);
  transition: var(--transition);
}

.size-pill:hover {
  border-color: var(--orange-neon);
  color: #FFFFFF;
}

.size-pill.active {
  background: rgba(255, 107, 26, 0.18);
  border-color: var(--orange-neon);
  color: var(--orange-neon);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.card-price {
  font-family: var(--font-display);
  font-size: 1.1875rem;
  font-weight: 700;
  color: var(--gold);
}

.card-price-unit {
  font-size: 0.8125rem;
  color: var(--text-muted);
  font-weight: 400;
  margin-right: 2px;
}

.btn-card-order {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 107, 26, 0.12);
  border: 1px solid rgba(255, 107, 26, 0.35);
  color: var(--orange-neon);
  font-size: 0.8125rem;
  font-weight: 600;
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  white-space: nowrap;
}

.btn-card-order:hover {
  background: var(--orange-neon);
  border-color: var(--orange-neon);
  color: #FFFFFF;
  box-shadow: 0 4px 12px var(--orange-glow);
  transform: translateY(-1px);
}

.no-items-found {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: var(--text-muted);
  background: var(--bg-card);
  border: 1px dashed var(--border-glass);
  border-radius: var(--radius-md);
}

/* ==========================================================================
   DEALS SECTION (id="deals") — SEPARATE
   ========================================================================== */
.deals-section {
  background: linear-gradient(180deg, rgba(10, 10, 15, 0.95) 0%, rgba(18, 18, 26, 0.9) 50%, rgba(10, 10, 15, 0.95) 100%);
  border-top: 1px solid var(--border-glass);
  border-bottom: 1px solid var(--border-glass);
}

/* Flagship Family Deal Banner */
.family-deal-card {
  margin-bottom: 60px;
  background: linear-gradient(135deg, rgba(28, 20, 20, 0.9), rgba(20, 20, 32, 0.95));
  border: 1px solid rgba(255, 215, 0, 0.3);
  border-radius: var(--radius-lg);
  padding: 32px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 30px var(--gold-glow);
  position: relative;
  overflow: hidden;
}

.family-deal-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.family-deal-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
}

@media (min-width: 900px) {
  .family-deal-content {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

.family-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 215, 0, 0.12);
  border: 1px solid var(--gold);
  color: var(--gold);
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 6px 14px;
  border-radius: 30px;
  margin-bottom: 12px;
}

.family-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 14px;
}

.family-items {
  font-size: 1.0625rem;
  color: #D2D2E0;
  line-height: 1.6;
  margin-bottom: 24px;
  padding: 16px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: var(--radius-sm);
  border-left: 3px solid var(--orange-neon);
}

.family-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
}

.family-price {
  font-family: var(--font-display);
  font-size: 2.25rem;
  font-weight: 700;
  color: var(--gold);
}

.family-image-wrapper {
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Sub-section headers in Deals */
.deal-subheading {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  color: #FFFFFF;
  margin: 40px 0 24px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.deal-subheading-icon {
