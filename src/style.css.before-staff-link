  align-items: flex-start;
  gap: 16px;
  transition: var(--transition);
}

.contact-info-card:hover {
  border-color: rgba(255, 107, 26, 0.3);
  background: var(--bg-card-hover);
}

.contact-icon-box {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: rgba(255, 107, 26, 0.1);
  border: 1px solid rgba(255, 107, 26, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--orange-neon);
  flex-shrink: 0;
}

.contact-card-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--gold);
  margin-bottom: 4px;
}

.contact-card-value {
  font-size: 0.9375rem;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.4;
}

.contact-card-link {
  color: #FFFFFF;
  transition: var(--transition);
}

.contact-card-link:hover {
  color: var(--orange-neon);
}

.btn-directions {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: rgba(255, 215, 0, 0.1);
  border: 1px solid var(--gold);
  color: var(--gold);
  font-weight: 600;
  font-size: 0.9375rem;
  padding: 14px 24px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  margin-top: 8px;
}

.btn-directions:hover {
  background: var(--gold);
  color: #0A0A0F;
  box-shadow: 0 4px 16px var(--gold-glow);
  transform: translateY(-1px);
}

/* Contact Form Right */
.contact-form-panel {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: 32px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
}

.form-title {
  font-family: var(--font-display);
  font-size: 1.375rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.form-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin-bottom: 24px;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: #D2D2E0;
}

.form-input, .form-textarea {
  width: 100%;
  background: rgba(10, 10, 15, 0.7);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  color: #FFFFFF;
  font-size: 0.9375rem;
  outline: none;
  transition: var(--transition);
}

.form-input:focus, .form-textarea:focus {
  border-color: var(--orange-neon);
  box-shadow: 0 0 14px rgba(255, 107, 26, 0.2);
  background: rgba(14, 14, 22, 0.95);
}

.form-textarea {
  min-height: 110px;
  resize: vertical;
}

.btn-form-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--orange-neon), #DE5008);
  color: #FFFFFF;
  font-size: 1rem;
  font-weight: 600;
  padding: 14px 24px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  box-shadow: 0 4px 18px var(--orange-glow);
  margin-top: 6px;
}

.btn-form-submit:hover {
  background: linear-gradient(135deg, var(--orange-hover), var(--orange-neon));
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255, 107, 26, 0.5);
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
.footer {
  background: #06060A;
  border-top: 1px solid var(--border-glass);
  padding: 60px 0 30px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 36px;
  margin-bottom: 48px;
}

@media (min-width: 640px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1.5fr 1fr 1fr;
  }
}

.footer-col-title {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 18px;
}

.footer-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 320px;
  margin-top: 12px;
}

.footer-links-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-link {
  font-size: 0.875rem;
  color: var(--text-muted);
  transition: var(--transition);
}

.footer-link:hover {
  color: var(--orange-neon);
  transform: translateX(3px);
}

.footer-hours-text {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.footer-hours-highlight {
  color: var(--gold);
  font-weight: 600;
  display: block;
  margin-top: 4px;
}

.footer-bottom {
  padding-top: 30px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8125rem;
  color: var(--text-dim);
  text-align: center;
}

@media (min-width: 768px) {
  .footer-bottom {
    flex-direction: row;
    text-align: left;
  }
}

.dev-credit {
  color: var(--text-muted);
}

.dev-credit a {
  color: var(--orange-neon);
  font-weight: 600;
  transition: var(--transition);
}

.dev-credit a:hover {
  color: var(--gold);
