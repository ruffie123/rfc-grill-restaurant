  font-size: 1.125rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.deal-items-list {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 18px;
  flex-grow: 1;
}

.deal-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.deal-price {
  font-family: var(--font-display);
  font-size: 1.3125rem;
  font-weight: 700;
  color: var(--gold);
}

.btn-deal-order {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--orange-neon), #DE5008);
  color: #FFFFFF;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 9px 16px;
  border-radius: var(--radius-sm);
  transition: var(--transition);
}

.btn-deal-order:hover {
  background: linear-gradient(135deg, var(--orange-hover), var(--orange-neon));
  box-shadow: 0 4px 14px var(--orange-glow);
  transform: translateY(-1px);
}

/* ==========================================================================
   ABOUT SECTION
   ========================================================================== */
.about-section {
  background: var(--bg-dark);
}

.about-story-box {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  padding: 36px;
  margin-bottom: 48px;
  max-width: 960px;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
