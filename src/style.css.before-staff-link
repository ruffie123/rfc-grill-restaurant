.btn-header-settings:hover {
  background: rgba(255, 107, 26, 0.15);
  border-color: rgba(255, 107, 26, 0.4);
  color: #FF6B1A;
}
.btn-header-settings svg { transition: transform 0.3s ease; }
.btn-header-settings:hover svg { transform: rotate(45deg); }

/* ===== Brand Logo Image ===== */
.brand-logo-img {
  height: 68px;
  width: 68px;
  object-fit: contain;
  border-radius: 50%;
  flex-shrink: 0;
  transition: transform 0.3s ease;
  filter: drop-shadow(0 2px 8px rgba(255, 107, 26, 0.25));
}

.brand:hover .brand-logo-img {
  transform: scale(1.08);
}

@media (max-width: 640px) {
  .brand-logo-img {
    height: 56px;
    width: 56px;
  }
}
